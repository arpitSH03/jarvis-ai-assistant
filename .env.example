# ==========================================
# JARVIS AI DESKTOP ASSISTANT CONFIGURATION
# ==========================================

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# AI Provider ("gemini", "openai", "groq", "offline_mock")
AI_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# API Keys (Optional: Leave blank to use offline intelligent planner)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Mock Mode: True enables offline mock data for Gmail and Calendar
MOCK_MODE=True

# Voice Synthesis (Edge TTS Neural Voices)
# Options: "en-US-ChristopherNeural" (US Calm), "en-GB-RyanNeural" (British), "en-IN-PrabhatNeural" (Indian)
TTS_VOICE=en-US-ChristopherNeural
TTS_ENGINE=edge_tts

# Google Workspace OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
